<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ImportMap />
    <HeadOutlet />
    <style>
        :root { --bg:#0f1115; --panel:#171a21; --panel2:#1e222b; --line:#2a2f3a; --fg:#e6e8ed; --mut:#9aa3b2; --acc:#4f8cff; --ok:#39d27f; --warn:#ffb454; --err:#ff5d6c; }
        * { box-sizing:border-box; }
        body { margin:0; font:14px/1.5 system-ui,Segoe UI,sans-serif; background:var(--bg); color:var(--fg); }
        a { color:var(--acc); text-decoration:none; } a:hover { text-decoration:underline; }
        h1 { font-size:20px; margin:0 0 16px; } h2 { font-size:16px; margin:20px 0 10px; color:var(--mut); font-weight:600; }
        .layout { display:flex; min-height:100vh; }
        .side { width:210px; background:var(--panel); border-right:1px solid var(--line); padding:18px 0; flex:0 0 auto; }
        .brand { font-weight:700; font-size:16px; padding:0 18px 16px; color:#fff; }
        .side a { display:block; padding:9px 18px; color:var(--mut); border-left:3px solid transparent; }
        .side a.active, .side a:hover { color:#fff; background:var(--panel2); border-left-color:var(--acc); text-decoration:none; }
        .main { flex:1; padding:26px 30px; max-width:1100px; }
        .card { background:var(--panel); border:1px solid var(--line); border-radius:10px; padding:18px; margin-bottom:18px; }
        table { width:100%; border-collapse:collapse; }
        th,td { text-align:left; padding:8px 10px; border-bottom:1px solid var(--line); }
        th { color:var(--mut); font-weight:600; font-size:12px; text-transform:uppercase; letter-spacing:.04em; }
        tr:hover td { background:var(--panel2); }
        input,select { background:var(--panel2); border:1px solid var(--line); color:var(--fg); border-radius:6px; padding:7px 9px; font:inherit; }
        input:focus,select:focus { outline:none; border-color:var(--acc); }
        label { display:block; color:var(--mut); font-size:12px; margin:0 0 4px; }
        .fields { display:grid; grid-template-columns:repeat(auto-fill,minmax(160px,1fr)); gap:14px; }
        button { background:var(--acc); color:#fff; border:0; border-radius:6px; padding:8px 14px; font:inherit; cursor:pointer; }
        button:hover { filter:brightness(1.1); } button.sec { background:var(--panel2); border:1px solid var(--line); }
        button.danger { background:var(--err); } button.ghost { background:transparent; border:1px solid var(--line); color:var(--mut); }
        .badge { font-size:11px; padding:2px 7px; border-radius:20px; background:var(--panel2); border:1px solid var(--line); color:var(--mut); }
        .badge.on { color:var(--ok); border-color:var(--ok); } .badge.ban { color:var(--err); border-color:var(--err); }
        .toast { padding:9px 12px; border-radius:6px; margin-bottom:12px; }
        .toast.ok { background:rgba(57,210,127,.12); color:var(--ok); } .toast.err { background:rgba(255,93,108,.12); color:var(--err); }
        .row { display:flex; gap:10px; align-items:end; flex-wrap:wrap; } .mut { color:var(--mut); } .right { text-align:right; }
        .invgrid { display:grid; grid-template-columns:repeat(auto-fill,minmax(76px,1fr)); gap:8px; margin-top:10px; }
        .cell { position:relative; aspect-ratio:1; border-radius:8px; border:1px solid var(--line); display:flex; flex-direction:column; align-items:center; justify-content:center; color:#fff; text-shadow:0 1px 2px rgba(0,0,0,.55); }
        .cell.click { cursor:pointer; } .cell.click:hover { outline:2px solid var(--acc); }
        .cell .iid { font-weight:700; font-size:15px; } .cell .ikind { font-size:10px; opacity:.85; }
        .cell .x { position:absolute; top:3px; right:3px; width:18px; height:18px; padding:0; line-height:16px; border-radius:50%; background:rgba(0,0,0,.5); border:0; opacity:0; font-size:13px; cursor:pointer; }
        .cell:hover .x { opacity:1; }
        .qrow { display:flex; gap:7px; margin-top:8px; flex-wrap:wrap; }
        .qcell { position:relative; width:56px; height:56px; border-radius:8px; border:1px solid var(--line); display:flex; align-items:center; justify-content:center; color:#fff; font-weight:700; font-size:13px; }
    </style>
</head>

<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
