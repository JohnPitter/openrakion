@page "/account/{Id}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject AdminDb Db
@inject AdminIdentity Identity
@inject IWebHostEnvironment Env
@inject ItemNames Names

<PageTitle>@Id — OpenRakion Admin</PageTitle>
<h1><a href="/accounts">Contas</a> › @Id</h1>

@if (_acc is null)
{
    <div class="card"><p class="mut">Conta não encontrada.</p></div>
}
else
{
    <div class="card">
        <label>Motivo/ticket para alterações desta conta</label>
        <input @bind="_actionReason" placeholder="obrigatório para senha, ban, PU e inventário" style="width:100%;" />
    </div>
    @if (_msg is not null) { <div class="toast @_msgKind">@_msg</div> }

    <div class="card">
        <h2>Saldos</h2>
        <div class="row">
            <div><label>Gold</label><input type="number" @bind="_gold" /></div>
            <button @onclick="() => SaveCurrency(CurrencyKind.Gold)">Salvar gold</button>
            <div style="margin-left:20px;"><label>Cash</label><input type="number" @bind="_cash" /></div>
            <button @onclick="() => SaveCurrency(CurrencyKind.Cash)">Salvar cash</button>
            <div style="margin-left:20px;"><label>Motivo obrigatório</label>
                <input @bind="_currencyReason" maxlength="200" /></div>
        </div>
        @if (_currencyAdjustments.Count > 0)
        {
            <table style="margin-top:16px;">
                <thead><tr><th>Quando</th><th>Moeda</th><th>Alteração</th><th>Saldo</th><th>Motivo</th><th>Operador</th></tr></thead>
                <tbody>
                    @foreach (var entry in _currencyAdjustments)
                    {
                        <tr><td>@entry.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td><td>@entry.Currency</td>
                            <td>@entry.Delta.ToString("+#;-#;0")</td><td>@entry.BalanceBefore → @entry.BalanceAfter</td>
                            <td>@entry.Reason</td><td>@entry.OperatorId</td></tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="card">
        <h2>Power User <span class="mut">(@(_acc.PuActive ? "ativo" : "inativo"))</span></h2>
        <div class="row">
            <div><label>Bônus points</label><input type="number" @bind="_puBonus" /></div>
            <div><label>Dias</label><input type="number" @bind="_puDays" /></div>
            <button @onclick="GrantPu">Conceder / renovar</button>
            <button class="danger" @onclick="ClearPu">Remover PU</button>
        </div>
    </div>

    <div class="card">
        <h2>Conta</h2>
        <div class="row">
            <div><label>Nova senha</label><input @bind="_pw" /></div>
            <button @onclick="SavePw">Trocar senha</button>
            @if (_acc.Ban)
            {
                <button class="sec" @onclick="() => SetBan(false)">Desbanir</button>
            }
            else
            {
                <button class="danger" @onclick="() => SetBan(true)">Banir</button>
            }
        </div>
    </div>

    <div class="card">
        <h2>Inventário (estilo do jogo)</h2>
        <div class="row">
            <div><label>Adicionar por id</label><input type="number" @bind="_addId" style="width:120px;" /></div>
            <button @onclick="AddById">+ adicionar</button>
            <div style="margin-left:18px;"><label>Procurar (nome ou id)</label>
                <input @bind="_itemTerm" @bind:event="oninput" @onkeyup="OnItemKey" placeholder="ex.: Mithril, Knight, 130" style="width:200px;" /></div>
            <div><label>Categoria</label>
                <select @bind="_typeFilter">
                    <option value="">todas</option>
                    @for (int t = 0; t <= 14; t++) { <option value="@t">@t · @ItemKind.Label(t)</option> }
                </select></div>
            <button class="sec" @onclick="SearchItems">Buscar</button>
        </div>
        @if (_itemHits.Count > 0)
        {
            <p class="mut" style="margin:14px 0 0;">Clique para adicionar:</p>
            <div class="invgrid">
                @foreach (var it in _itemHits)
                {
                    <div class="cell click" style="background:@ItemKind.Color(it.Type)" @onclick="() => AddItem(it.Id)" title="@($"adicionar item {it.Id}")">
                        @if (_icons.Contains(it.Id)) { <img src="/icons/@(it.Id).png" class="ico" alt="" /> }
                        <span class="iname">@(Names.Get(it.Id) ?? ("#" + it.Id))</span>
                        <span class="ikind">@it.Id · @ItemKind.Label(it.Type)</span>
                    </div>
                }
            </div>
        }

        <div class="invwrap">
            <div class="gpanel">
                <div class="gphead"><span>Inventory</span><span class="mut">@(_char?.Name ?? "—")</span></div>
                <div class="gbody">
                    @if (_char is not null)
                    {
                        <div class="equipcol">
                            @foreach (var e in _equip.Where(e => e.Slot <= 5).OrderBy(e => e.Slot))
                            {
                                <div class="cell" style="background:@ItemKind.Color(e.Type)" title="@($"slot {e.Slot} · {Names.Get(e.ItemId) ?? e.ItemId.ToString()}")">
                                    @if (_icons.Contains(e.ItemId)) { <img src="/icons/@(e.ItemId).png" class="ico" alt="" /> }
                                    <span class="iname">@(Names.Get(e.ItemId) ?? ("#" + e.ItemId))</span>
                                    <span class="idtag">@e.ItemId</span>
                                </div>
                            }
                            @if (_equip.Count == 0) { <span class="mut" style="grid-column:1/-1;">sem aparência salva</span> }
                        </div>
                        <div class="gstats">
                            <div class="srow"><span>Level @_char.Level · classe @_char.Class</span><b>Level point @_char.LevelPoint</b></div>
                            @for (int i = 0; i < 10; i++)
                            {
                                <div class="srow"><span>@StatNames.Labels[i]</span><b>@_char.Stats[i]</b></div>
                            }
                        </div>
                    }
                    else { <p class="mut">Conta sem personagem.</p> }
                </div>
            </div>

            <div class="gpanel">
                <div class="gphead"><span>Box</span><span class="mut">@_box.Count(b => b.QSlot == 0) itens</span></div>
                <div class="gbody">
                    <div class="invgrid">
                        @foreach (var b in _box.Where(b => b.QSlot == 0))
                        {
                            <div class="cell" style="background:@ItemKind.Color(b.Type)" title="@($"box id {b.Id} · {Names.Get(b.ItemId) ?? b.ItemId.ToString()} · type {b.Type}")">
                                @if (_icons.Contains(b.ItemId)) { <img src="/icons/@(b.ItemId).png" class="ico" alt="" /> }
                                <span class="iname">@(Names.Get(b.ItemId) ?? ("#" + b.ItemId))</span>
                                <span class="ikind">@b.ItemId · @ItemKind.Label(b.Type)</span>
                                <button class="x" @onclick="() => RemoveItem(b.Id)">×</button>
                            </div>
                        }
                    </div>
                    @if (!_box.Any(b => b.QSlot == 0)) { <p class="mut">Box vazio.</p> }

                    <div style="font-size:12px;color:var(--mut);margin:14px 0 4px;">Potion slot</div>
                    <div class="qrow">
                        @foreach (var q in _box.Where(b => b.QSlot > 0).OrderBy(b => b.QSlot))
                        {
                            <div class="qcell" style="background:@ItemKind.Color(q.Type)" title="@($"cell {q.QSlot - 1} · {Names.Get(q.ItemId) ?? q.ItemId.ToString()}")">
                                @if (_icons.Contains(q.ItemId)) { <img src="/icons/@(q.ItemId).png" class="ico" alt="" /> }
                                <span class="iname">@(Names.Get(q.ItemId) ?? ("#" + q.ItemId))</span>
                                <button class="x" @onclick="() => RemoveItem(q.Id)">×</button>
                            </div>
                        }
                        @if (!_box.Any(b => b.QSlot > 0)) { <span class="mut">— vazio —</span> }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";
    private AccountRow? _acc;
    private CharFull? _char;
    private List<EquipSlot> _equip = new();
    private List<BoxItemRow> _box = new();
    private List<ItemDef> _itemHits = new();
    private IReadOnlyList<CurrencyAdjustmentRow> _currencyAdjustments = [];
    private long _gold, _cash;
    private int _puBonus = 51, _puDays = 30;
    private string _pw = "", _itemTerm = "", _typeFilter = "", _currencyReason = "", _actionReason = "";
    private int _addId;
    private string? _msg, _msgKind;
    private HashSet<int> _icons = new();   // ids com ícone capturado em wwwroot/icons/<id>.png

    protected override async Task OnParametersSetAsync() { LoadIcons(); await Reload(); }

    private void LoadIcons()
    {
        _icons = new();
        try
        {
            var dir = Path.Combine(Env.WebRootPath, "icons");
            if (Directory.Exists(dir))
                foreach (var f in Directory.EnumerateFiles(dir, "*.png"))
                    if (int.TryParse(Path.GetFileNameWithoutExtension(f), out var id)) _icons.Add(id);
        }
        catch { }
    }

    private async Task Reload()
    {
        _acc = await Db.GetAccountAsync(Id);
        if (_acc is null) return;
        _currencyAdjustments = await Db.ListCurrencyAdjustmentsAsync(Id);
        _gold = _acc.Gold; _cash = _acc.Cash;
        if (_acc.GiId > 0)
        {
            _box = await Db.ListBoxAsync(_acc.GiId);
            _char = await Db.GetActiveCharAsync(_acc.GiId);
            _equip = _char is not null ? await Db.ListEquipAsync(_char.Id) : new();
        }
        else { _box = new(); _char = null; _equip = new(); }
    }

    private void Ok(string m) { _msg = m; _msgKind = "ok"; }
    private void Err(string m) { _msg = m; _msgKind = "err"; }

    private async Task SaveCurrency(CurrencyKind currency)
    {
        try
        {
            long target = currency == CurrencyKind.Gold ? _gold : _cash;
            CurrencyAdjustmentResult result = await Db.AdjustCurrencyAsync(
                new CurrencyAdjustmentRequest(Id, _acc!.GiId, currency,
                    target, _currencyReason, Identity.OperatorId));
            _currencyReason = "";
            Ok(result.Changed
                ? $"{currency} ajustado em {result.Delta:+#;-#;0}."
                : $"{currency} já possuía esse saldo.");
            await Reload();
        }
        catch (Exception ex) { Err(ex.Message); }
    }
    private async Task GrantPu() { if (_acc!.GiId <= 0) { Err("conta sem perfil"); return; } await RunAudited(() => Db.SetPowerUserAsync(_acc.GiId, _puBonus, _puDays, _actionReason), $"PU concedido (+{_puDays}d)."); }
    private async Task ClearPu() { if (_acc!.GiId > 0) await RunAudited(() => Db.ClearPowerUserAsync(_acc.GiId, _actionReason), "PU removido."); }
    private async Task SavePw() { if (string.IsNullOrWhiteSpace(_pw)) { Err("senha vazia"); return; } await RunAudited(() => Db.SetPasswordAsync(Id, _pw, _actionReason), "Senha trocada."); _pw = ""; }
    private async Task SetBan(bool b) => await RunAudited(() => Db.SetBanAsync(Id, b, _actionReason), b ? "Conta banida." : "Conta desbanida.");
    private async Task SearchItems()
    {
        int? type = int.TryParse(_typeFilter, out var t) ? t : null;
        var nameIds = Names.Search(_itemTerm);   // ids cujo NOME casa o termo (busca por nome)
        _itemHits = await Db.SearchItemsAsync(_itemTerm, type, nameIds);
    }
    private async Task OnItemKey(KeyboardEventArgs e) { if (e.Key == "Enter") await SearchItems(); }
    private async Task AddById() { if (_addId > 0) await AddItem(_addId); }
    private async Task AddItem(int itemId) { if (_acc!.GiId <= 0) { Err("conta sem perfil"); return; } await RunAudited(() => Db.AddItemBoxAsync(_acc.GiId, itemId, _actionReason), $"Item {itemId} adicionado."); }
    private async Task RemoveItem(int boxId) => await RunAudited(() => Db.DeleteBoxItemAsync(boxId, _actionReason), "Item removido.");

    private async Task RunAudited(Func<Task> action, string success)
    {
        if (string.IsNullOrWhiteSpace(_actionReason)) { Err("Informe o motivo/ticket da alteração."); return; }
        try { await action(); Ok(success); await Reload(); }
        catch (Exception ex) { Err(ex.Message); }
    }
}
