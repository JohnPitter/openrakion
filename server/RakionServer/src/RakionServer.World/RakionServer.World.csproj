<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RakionServer.World</RootNamespace>
    <AssemblyName>RakionWorldServer</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- CS0219: variaveis que documentam o parse do pacote nos handlers reconstruidos
         cujo corpo profundo ainda esta sendo desenvolvido (ver WorldHandlers.Generated.cs). -->
    <NoWarn>$(NoWarn);CS0219</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.3.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RakionServer.Common\RakionServer.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Blobs do replay de login (oraculo): respostas 0x0C/0x0D capturadas do worldserv original
         via MITM. SEM eles o cliente trava em "Logging in." (ClientSession.ReadOracle le do
         diretorio do exe). Copiados ao output no build. -->
    <None Include="oracle_*.bin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
