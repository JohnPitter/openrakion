<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Host headless da engine.dll (Serious Engine 1) — o "corpo" de netcode do bot.
    Processo .NET x86 que carrega a engine.dll in-proc e dirige seus exports C++
    (ThisCall/Cdecl em enderecos fixos, base 0x36000000 sem ASLR) para registrar o bot
    como PEER REAL na sessao do cliente-host. NAO entra na .sln principal (x64): builda
    standalone via dotnet publish (self-contained win-x86). Ver docs/headless-bot-status.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RakionEngineHost</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
