<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Buddy Server (BuddyServer :8500 / BuddyCenter :8504) — reconstruido por RE do
    Buddy2.dll (client-side; PDB WolfTeam_Buddy_dll/Buddy3). O servidor de buddy
    nao vinha no pacote v258 e e OPCIONAL (o client tolera timeout), entao esta
    e a primeira implementacao do lado servidor. Ver PROTOCOL-BUDDY.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RakionServer.Buddy</RootNamespace>
    <AssemblyName>BuddyServer</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.3.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RakionServer.Common\RakionServer.Common.csproj" />
  </ItemGroup>

</Project>
