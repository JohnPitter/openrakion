<?xml version="1.0" encoding="utf-8"?>
<!--
  Perfil de publish do RakionLauncher: FRAMEWORK-DEPENDENT single-file (win-x64).
  Launcher de ~0,5 MB — exige o .NET 9 Desktop Runtime instalado na máquina. Se faltar, o apphost do
  Windows mostra um diálogo nativo com o link de download (https://aka.ms/dotnet-core-applaunch).
  Escolha framework-dependent (vs self-contained ~48 MB) p/ updates minúsculos no auto-update.

  Publique com:  dotnet publish -p:PublishProfile=win-x64
  Saída:         bin\publish\RakionLauncher.exe
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishDir>bin\publish\</PublishDir>
  </PropertyGroup>
</Project>
